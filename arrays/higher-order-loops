call back functions on array
const arr=[100,200,300,400,500]

arr.forEach(function (item){
  console.log(item);
})
--using arrow functions
arr.forEach((item)=>{
  console.log(item);
})

---we can keep the second parameter as index
arr.forEach((item)=>{
  console.log(item);
})
